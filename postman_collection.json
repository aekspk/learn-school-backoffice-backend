{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Learn School Backoffice API",
    "description": "NestJS REST API for the Attendance & Credit System. Base URL: http://localhost:9191\n\nAuth Flow:\n1. POST /auth/login — the Test script auto-sets {{access_token}} and {{refresh_token}}.\n2. All other protected endpoints inherit the collection-level Bearer {{access_token}} auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:9191",
      "type": "string",
      "description": "Base URL of the API server"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string",
      "description": "JWT access token — auto-populated by the Login request Test script"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string",
      "description": "JWT refresh token — auto-populated by the Login request Test script"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints — register, login, token refresh, profile management, and logout.",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@school.com\",\n  \"password\": \"password123\",\n  \"name\": \"HQ Admin\",\n  \"branchId\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user account. `branchId` is required for BRANCH_MANAGER / BRANCH_STAFF roles; omit or set null for HQ_ADMIN."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.accessToken) {",
                  "    pm.collectionVariables.set('access_token', json.accessToken);",
                  "    console.log('access_token saved:', json.accessToken.substring(0, 20) + '...');",
                  "}",
                  "if (json && json.refreshToken) {",
                  "    pm.collectionVariables.set('refresh_token', json.refreshToken);",
                  "    console.log('refresh_token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@school.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate and receive access + refresh tokens. The Test script automatically stores both tokens as collection variables."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{refresh_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": { "mode": "none" },
            "url": {
              "raw": "{{base_url}}/auth/refresh-token",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh-token"]
            },
            "description": "Exchange a valid refresh token (sent as Bearer) for a new access token. Uses {{refresh_token}} — NOT {{access_token}}."
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["auth", "profile"]
            },
            "description": "Returns the authenticated user's profile."
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Updated Name", "type": "text", "description": "Display name" },
                { "key": "email", "value": "updated@school.com", "type": "text", "description": "Email address" },
                { "key": "password", "value": "newpassword123", "type": "text", "description": "New password (min 8 chars) — omit to keep current" },
                { "key": "address[houseNumber]", "value": "123/4", "type": "text" },
                { "key": "address[village]", "value": "Moo 5", "type": "text" },
                { "key": "address[road]", "value": "Sukhumvit Road", "type": "text" },
                { "key": "address[district]", "value": "Watthana", "type": "text" },
                { "key": "address[province]", "value": "Bangkok", "type": "text" },
                { "key": "address[postalCode]", "value": "10110", "type": "text" },
                { "key": "image", "value": "", "type": "file", "src": "", "description": "Optional profile image (jpg/jpeg/png, max 1 MB)" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["auth", "profile"]
            },
            "description": "Update the authenticated user's profile. Sent as multipart/form-data to support optional image upload."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "DELETE",
            "header": [],
            "body": { "mode": "none" },
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Invalidates the current refresh token (sets it to null in the DB). Returns 204 No Content."
          }
        }
      ]
    },
