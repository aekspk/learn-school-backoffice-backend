    {
      "name": "Bookings",
      "description": "Student booking management. Handles creation, attendance marking, and cancellation.",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": 1,\n  \"classSessionId\": 1,\n  \"packageId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/bookings",
              "host": ["{{base_url}}"],
              "path": ["bookings"]
            },
            "description": "`packageId` is optional — if omitted, the system auto-selects the best valid package (course-specific first, earliest expiry first). Guarded against overbooking, double-booking, and time overlaps."
          }
        },
        {
          "name": "Get All Bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/bookings?classSessionId=1&studentId=1",
              "host": ["{{base_url}}"],
              "path": ["bookings"],
              "query": [
                {
                  "key": "classSessionId",
                  "value": "1",
                  "description": "Optional — filter by class session"
                },
                {
                  "key": "studentId",
                  "value": "1",
                  "description": "Optional — filter by student"
                }
              ]
            }
          }
        },
        {
          "name": "Get Booking by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/bookings/1",
              "host": ["{{base_url}}"],
              "path": ["bookings", "1"]
            }
          }
        },
        {
          "name": "Mark Attendance",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ATTENDED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/bookings/1/attendance",
              "host": ["{{base_url}}"],
              "path": ["bookings", "1", "attendance"]
            },
            "description": "Transitions booking status. Valid values: ATTENDED, SKIPPED, ABSENT, CANCELLED. ATTENDED and SKIPPED trigger credit deduction. SKIPPED atomically creates a Compensation record. Terminal states (ATTENDED, SKIPPED, ABSENT) cannot be changed."
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/bookings/1",
              "host": ["{{base_url}}"],
              "path": ["bookings", "1"]
            },
            "description": "Cancels a BOOKED booking and refunds the credit. Returns 200 with updated booking."
          }
        }
      ]
    },
    {
      "name": "Compensations",
      "description": "Compensation records issued when a student skips a class. Resolution requires HQ_ADMIN or BRANCH_MANAGER.",
      "item": [
        {
          "name": "Create Compensation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": 1,\n  \"type\": \"MAKEUP_CLASS\",\n  \"note\": \"Student requested a makeup class for the missed session.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/compensations",
              "host": ["{{base_url}}"],
              "path": ["compensations"]
            },
            "description": "Valid `type` values: MAKEUP_CLASS, SEAT_CREDIT, EXPIRY_EXTENSION. Typically created automatically on SKIPPED attendance, but can be created manually."
          }
        },
        {
          "name": "Get All Compensations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/compensations?status=PENDING",
              "host": ["{{base_url}}"],
              "path": ["compensations"],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING",
                  "description": "Optional — filter by CompensationStatus. Valid: PENDING, RESOLVED, REJECTED"
                }
              ]
            }
          }
