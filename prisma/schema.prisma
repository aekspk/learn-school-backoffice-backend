generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  HQ_ADMIN
  BRANCH_MANAGER
  BRANCH_STAFF
}

enum BookingStatus {
  BOOKED // Seat reserved. Credit deduction: 0. Reduces available seats by 1.
  ATTENDED // Attended class. Credit deduction: -1.
  SKIPPED // Approved leave. Credit deduction: 0. Compensation MUST be issued.
  ABSENT // No-show. Credit deduction: -1. No compensation granted.
}

// Matches the exact three compensation mechanisms named in the assignment spec.
enum CompensationType {
  MAKEUP_CLASS // Student is booked into a makeup session
  SEAT_CREDIT // A credit is added back to their package
  EXPIRY_EXTENSION // The package expiry date is extended
}

enum CompensationStatus {
  PENDING
  RESOLVED
  REJECTED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Branch {
  id            Int            @id @default(autoincrement())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  classSessions ClassSession[]
}

model User {
  id                    Int            @id @default(autoincrement())
  name                  String
  email                 String         @unique
  image                 String?
  password              String
  refreshToken          String?        @unique
  role                  Role           @default(BRANCH_STAFF)
  // null for HQ_ADMIN; required for BRANCH_MANAGER / BRANCH_STAFF
  branchId              Int?
  branch                Branch?        @relation(fields: [branchId], references: [id])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  markedBookings        Booking[]      @relation("MarkedBy")
  resolvedCompensations Compensation[] @relation("ResolvedBy")
}

model Student {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  phone          String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  creditPackages CreditPackage[]
  bookings       Booking[]
}

model Course {
  id             Int             @id @default(autoincrement())
  name           String
  totalSessions  Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  courseLessons  CourseLesson[]
  classSessions  ClassSession[]
  // Only course-specific packages appear here; global packages have courseId = null
  creditPackages CreditPackage[]
}

model CourseLesson {
  id            Int            @id @default(autoincrement())
  courseId      Int
  order         Int
  topic         String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  course        Course         @relation(fields: [courseId], references: [id])
  classSessions ClassSession[]

  @@unique([courseId, order])
  @@index([courseId])
}

model CreditPackage {
  id               Int                 @id @default(autoincrement())
  studentId        Int
  courseId         Int
  totalCredits     Int
  remainingCredits Int
  expiresAt        DateTime
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  student          Student             @relation(fields: [studentId], references: [id])
  course           Course              @relation(fields: [courseId], references: [id])
  bookings         Booking[]
  transactions     CreditTransaction[]

  @@index([studentId, expiresAt])
}

model ClassSession {
  id             Int           @id @default(autoincrement())
  branchId       Int
  courseId       Int
  courseLessonId Int?
  scheduledAt    DateTime
  durationMin    Int           @default(60)
  totalSeats     Int
  // INVARIANT: bookedSeats <= totalSeats — enforced at service layer and via
  // CHECK constraint in migration: CHECK (booked_seats <= total_seats)
  bookedSeats    Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  branch         Branch        @relation(fields: [branchId], references: [id])
  course         Course        @relation(fields: [courseId], references: [id])
  courseLesson   CourseLesson? @relation(fields: [courseLessonId], references: [id])
  bookings       Booking[]

  @@index([branchId, scheduledAt])
  @@index([courseId])
  @@index([scheduledAt, durationMin])
}

model Booking {
  id             Int                @id @default(autoincrement())
  studentId      Int
  classSessionId Int
  packageId      Int
  markedById     Int?
  status         BookingStatus      @default(BOOKED)
  // Timestamp for when status was last changed to a terminal state (ATTENDED/SKIPPED/ABSENT)
  markedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  student        Student            @relation(fields: [studentId], references: [id])
  classSession   ClassSession       @relation(fields: [classSessionId], references: [id])
  package        CreditPackage      @relation(fields: [packageId], references: [id])
  markedByUser   User?              @relation("MarkedBy", fields: [markedById], references: [id])
  compensation   Compensation?
  transaction    CreditTransaction?

  // Prevent double-booking: one student per session
  @@unique([studentId, classSessionId])
  @@index([studentId])
  @@index([classSessionId])
  @@index([packageId])
  @@index([status])
}

// Immutable credit ledger. One row per deduction or refund event.
// This is the source of truth for credit balance history; remainingCredits
// on CreditPackage is a derived cache that must stay consistent with this table.
model CreditTransaction {
  id        Int           @id @default(autoincrement())
  packageId Int
  bookingId Int?          @unique
  // Negative = deduction (-1 for ATTENDED/ABSENT), positive = refund/addition
  delta     Int
  reason    String
  createdAt DateTime      @default(now())
  package   CreditPackage @relation(fields: [packageId], references: [id])
  booking   Booking?      @relation(fields: [bookingId], references: [id])

  @@index([packageId])
}

model Compensation {
  id           Int                @id @default(autoincrement())
  bookingId    Int                @unique
  type         CompensationType?
  status       CompensationStatus @default(PENDING)
  note         String?
  resolvedById Int?
  resolvedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  booking      Booking            @relation(fields: [bookingId], references: [id])
  resolvedBy   User?              @relation("ResolvedBy", fields: [resolvedById], references: [id])

  @@index([status])
}
